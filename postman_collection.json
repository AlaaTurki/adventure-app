{
  "info": {
    "name": "Adventure App API Tests",
    "description": "Postman collection for Book and Game endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "gameId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "GET all books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "GET book by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "GET book by title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/title/The Crystal Caverns",
              "host": ["{{baseUrl}}"],
              "path": ["books", "title", "The Crystal Caverns"]
            }
          }
        },
        {
          "name": "GET section by book and section id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/sections/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}", "sections", "1"]
            }
          }
        },
        {
          "name": "POST create book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Adventure\",\n  \"author\": \"Postman\",\n  \"difficulty\": \"EASY\",\n  \"sections\": [\n    {\n      \"id\": 1,\n      \"type\": \"BEGIN\",\n      \"text\": \"You stand in a quiet clearing. What do you do?\",\n      \"options\": [\n        {\n          \"description\": \"Follow the path ahead\",\n          \"gotoId\": 2,\n          \"consequence\": {\n            \"type\": \"HEALTH\",\n            \"value\": \"0\",\n            \"text\": \"You walk carefully and stay steady.\"\n          }\n        },\n        {\n          \"description\": \"Inspect the ruins\",\n          \"gotoId\": 3,\n          \"consequence\": {\n            \"type\": \"GAIN_HEALTH\",\n            \"value\": \"1\",\n            \"text\": \"You find a hidden charm.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": 2,\n      \"type\": \"NODE\",\n      \"text\": \"The path opens into a valley.\",\n      \"options\": [\n        {\n          \"description\": \"Cross to the bridge\",\n          \"gotoId\": 4,\n          \"consequence\": {\n            \"type\": \"LOSE_HEALTH\",\n            \"value\": \"-2\",\n            \"text\": \"The bridge groans beneath your feet.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": 3,\n      \"type\": \"NODE\",\n      \"text\": \"The ruins whisper an old story.\",\n      \"options\": [\n        {\n          \"description\": \"Follow the whisper\",\n          \"gotoId\": 4,\n          \"consequence\": {\n            \"type\": \"HEALTH\",\n            \"value\": \"0\",\n            \"text\": \"You trust your instincts and keep moving.\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": 4,\n      \"type\": \"END\",\n      \"text\": \"The journey ends with a quiet victory.\",\n      \"options\": []\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        }
      ]
    },
    {
      "name": "Games",
      "item": [
        {
          "name": "POST start game",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"gameId\", json.id);",
                  "pm.test(\"Status code is 200\", function () {\n  pm.response.to.have.status(200);\n});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/start?bookId={{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["games", "start"],
              "query": [
                {
                  "key": "bookId",
                  "value": "{{bookId}}"
                }
              ]
            }
          }
        },
        {
          "name": "GET current game",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}",
              "host": ["{{baseUrl}}"],
              "path": ["games", "{{gameId}}"]
            }
          }
        },
        {
          "name": "POST choose option",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionIndex\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}/choices",
              "host": ["{{baseUrl}}"],
              "path": ["games", "{{gameId}}", "choices"]
            }
          }
        },
        {
          "name": "POST save game",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}/save",
              "host": ["{{baseUrl}}"],
              "path": ["games", "{{gameId}}", "save"]
            }
          }
        },
        {
          "name": "GET saved games",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/saved?bookId={{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["games", "saved"],
              "query": [
                {
                  "key": "bookId",
                  "value": "{{bookId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "❌ Validation / Error Cases",
      "item": [
        {
          "name": "Test 1 - GET /books/999999",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/999999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "999999"]
            }
          }
        },
        {
          "name": "Test 2 - GET /books/999999/sections/1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/999999/sections/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "999999", "sections", "1"]
            }
          }
        },
        {
          "name": "Test 3 - POST /games/start?bookId=999999",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games/start?bookId=999999",
              "host": ["{{baseUrl}}"],
              "path": ["games", "start"],
              "query": [
                {
                  "key": "bookId",
                  "value": "999999"
                }
              ]
            }
          }
        },
        {
          "name": "Test 4 - Invalid option index",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionIndex\": 999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}/choices",
              "host": ["{{baseUrl}}"],
              "path": ["games", "{{gameId}}", "choices"]
            }
          }
        },
        {
          "name": "Test 5 - Choice after WON",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 or 409\", function () {\n  pm.expect([400, 409]).to.include(pm.response.code);\n});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionIndex\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/games/{{gameId}}/choices",
              "host": ["{{baseUrl}}"],
              "path": ["games", "{{gameId}}", "choices"]
            }
          }
        }
      ]
    }
  ]
}
